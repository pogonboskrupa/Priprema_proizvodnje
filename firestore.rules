rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dozvoliti pristup samo korisnicima koji su anonimno prijavljeni
    // (app se automatski prijavljuje anonymously pri učitavanju)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
